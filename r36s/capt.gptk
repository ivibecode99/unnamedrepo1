# gptokeyb mapping: R36S/R36H pad -> keyboard bindings used by Capt & Co.
# (matches Settings.ACTIONS in game/autoload/settings.gd)
a = space
b = c
x = e
y = q
l1 = v
r1 = leftshift
l2 = left
r2 = right
start = esc
back = tab
up = w
down = s
left = a
right = d
left_analog_up = w
left_analog_down = s
left_analog_left = a
left_analog_right = d
right_analog_up = up
right_analog_down = down
right_analog_left = left
right_analog_right = right
deadzone_mode = mouse
deadzone = 6000
