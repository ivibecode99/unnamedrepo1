extends RefCounted
## Scene routing through Main: title -> world -> title.
func run(t) -> void:
	var g = t.root.get_node("Game")
	var main = load("res://main.tscn").instantiate()
	t.root.add_child(main)
	await t.frames(30)
	t.check(main.current is TitleScreen, "Main starts on title screen")
	g.data = g.blank_data()
	g.goto_world("forest")
	await t.frames(90)
	t.check(main.current is World, "goto_world loads a World")
	t.check(main.current.kingdom_id == "forest", "correct kingdom loaded")
	g.goto_world("hub")
	await t.frames(90)
	t.check(main.current is World and main.current.kingdom_id == "hub", "hub loads")
	g.goto_title()
	await t.frames(90)
	t.check(main.current is TitleScreen, "back to title")
	g.goto_intro()
	await t.frames(60)
	t.check(main.current is IntroScene, "intro scene loads")
	main.queue_free()
	await t.frames(3)
